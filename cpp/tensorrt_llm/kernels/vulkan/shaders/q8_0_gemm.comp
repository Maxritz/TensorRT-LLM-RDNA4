// Q8_0 GEMM (non-cooperative-matrix reference path):
//   C[M,N] = A[M,K] * W_dequant[N,K]^T,  i.e.  C[m,n] = sum_k A[m,k] * W[n,k]
//
// Weights use the GGML block_q8_0 layout: each 36-byte block holds a fp32 scale
// followed by 32 signed int8 weights. K must be a multiple of 32.
// blocks_per_row = K / 32 is the number of blocks in each weight row.
//
// Push constants: matches VulkanKernelDispatcher::dispatchQ8_0Gemm.
#version 460

#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, scalar) uniform PC {
    uint M;
    uint N;
    uint K;
    uint blocks_per_row;
} pc;

// Q8_0 block: 4-byte fp32 scale + 32 signed int8 weights = 36 bytes.
layout(std430, binding = 0) restrict readonly  buffer BufW { int8_t  w_bytes[]; };
layout(std430, binding = 1) restrict readonly  buffer BufA { float   a[]; };   // [M,K]
layout(std430, binding = 2) restrict writeonly buffer BufO { float   o[]; };   // [M,N]

float loadFp32Scale(uint byteBase) {
    uint b0 = uint(uint8_t(w_bytes[byteBase]));
    uint b1 = uint(uint8_t(w_bytes[byteBase + 1u]));
    uint b2 = uint(uint8_t(w_bytes[byteBase + 2u]));
    uint b3 = uint(uint8_t(w_bytes[byteBase + 3u]));
    uint bits = b0 | (b1 << 8u) | (b2 << 16u) | (b3 << 24u);
    return uintBitsToFloat(bits);
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint total = pc.M * pc.N;
    if (tid >= total) {
        return;
    }

    uint r = tid / pc.N; // activation row m (0..M-1)
    uint c = tid % pc.N; // weight row / output col n (0..N-1)

    float acc = 0.0;
    for (uint k = 0u; k < pc.K; ++k) {
        uint blk = k / 32u;
        uint within = k % 32u;
        uint byteBase = (c * pc.blocks_per_row + blk) * 36u;

        float scale = loadFp32Scale(byteBase);
        int8_t wv = w_bytes[byteBase + 4u + within];

        float aw = a[r * pc.K + k];
        acc += aw * (float(wv) * scale);
    }
    o[tid] = acc;
}
