#version 460

#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require

// Specialization constants for wave size adaptation
layout(constant_id = 0) const uint SPEC_SUBGROUP_SIZE = 32;
layout(constant_id = 1) const uint SPEC_LOCAL_SIZE_X = 32; // 32 for wave32, 64 for wave64

// Wave size adaptive dispatch
#if SPEC_SUBGROUP_SIZE == 64
layout(local_size_x = 64) in;
#else
layout(local_size_x = 32) in;
#endif

layout(push_constant, scalar) uniform PC {
    uint M, N, K;
    uint blocks_per_row;
} pc;

// Q8_0 quantized weights: 32 int8 values + 1 fp16 scale = 34 bytes per block
layout(std430, binding = 0) restrict readonly  buffer BufW   { int8_t    w_bytes[]; };
layout(std430, binding = 1) restrict readonly  buffer BufA   { float16_t a[]; };
layout(std430, binding = 2) restrict writeonly buffer BufO   { float16_t o[]; };

shared int8_t    s_wq    [16 * 16];
shared int8_t    s_aq    [16 * 16];
shared int32_t   s_int32 [16 * 16];
shared float     s_fp32  [16 * 16];
shared float     s_wscale[16];
shared float     s_ascale[16];
shared float16_t s_out   [16 * 16];

float q8_block_scale(uint byte_base) {
    uint lo = uint(uint8_t(w_bytes[byte_base]));
    uint hi = uint(uint8_t(w_bytes[byte_base + 1u]));
    return float(unpackHalf2x16((hi << 8u) | lo).x);
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint out_row_base = gl_WorkGroupID.y * 16u;
    uint out_col_base = gl_WorkGroupID.x * 16u;
    if (out_row_base >= pc.M || out_col_base >= pc.N) return;

    // Use cooperative matrix for RDNA3+/CDNA2+
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_fp32;
    [[unroll]] for (uint i = 0u; i < acc_fp32.length(); i++) acc_fp32[i] = float(0);

    for (uint blk = 0u; blk < pc.blocks_per_row; blk++) {
        // Weight scales
        if (tid < 16u) {
            uint w_row = out_row_base + tid;
            s_wscale[tid] = (w_row < pc.M)
                ? q8_block_scale((w_row * pc.blocks_per_row + blk) * 34u) : 1.0;
        }
        barrier();

        // Load and compute
        for (uint sub = 0u; sub < 2u; sub++) {
            uint w_k_off = sub * 16u;
            uint k_abs_base = blk * 32u + w_k_off;

            // Load weight tile
            if (tid < 16u) {
                uint elem = tid * 2u;
                uint w_row = out_row_base + elem / 16u;
                uint w_col = out_col_base + (elem % 16u);
                int8_t wv = int8_t(0);

                if (w_row < pc.M) {
                    uint byte_offset = (w_row * pc.blocks_per_row + blk) * 34u + 2u + (elem % 16u) / 2u;
                    uint byte_idx = byte_offset;
                    uint qs_byte = w_bytes[byte_idx];
                    uint pair = elem % 2u;
                    wv = int8_t((qs_byte >> (4u * pair)) & 0x0Fu) - 8;
                }
                s_wq[tid * 2u + 0u] = wv;
                s_wq[tid * 2u + 1u] = wv; // Simplified - proper packing needed
            }

            barrier();

            // Load activation tile
            if (tid < 16u) {
                uint elem = tid * 2u;
                uint a_row = k_abs_base + elem / 16u;
                uint a_col = elem % 16u;
                float16_t av = (a_row < pc.K) ? a[a_row * pc.K + a_col] : float16_t(0.0);
                s_aq[tid * 2u + 0u] = int8_t(float(av) * 127.0f);
                s_aq[tid * 2u + 1u] = s_aq[tid * 2u + 0u];
            }

            barrier();

            // Cooperative matrix multiply-accumulate
            // This requires cooperative matrix support (RDNA3+/CDNA2+)
            // For RDNA2, we'd use manual MAC loops instead
            #ifdef HAS_COOP_MATRIX
            {
                coopmat<int8_t, gl_ScopeSubgroup, 16, 16, 16, gl_MatrixUseB> b_mat;
                coopmat<int8_t, gl_ScopeSubgroup, 16, 16, 16, gl_MatrixUseA> a_mat;

                // Load matrices from shared memory
                // (Simplified - proper loading requires more complex indexing)
                acc_fp32 = coopMatMulAdd(gl_ScopeSubgroup, gl_MatrixLayoutRowMajor,
                    a_mat, b_mat, acc_fp32);
            }
            #endif
        }

        barrier();

        // Apply activation scaling
        if (tid < 16u) {
            float w_scale = s_wscale[tid / 16u];
            float a_scale = 1.0f; // Would load from activation scales
            float scale = w_scale * a_scale;
            s_out[tid] = float16_t(float(acc_fp32[tid]) * scale);
        }

        barrier();
    }

    // Write output
    if (tid < 16u) {
        uint out_row = out_row_base + tid;
        if (out_row < pc.M) {
            o[out_row] = s_out[tid];
        }
    }
}
