#version 460

#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, scalar) uniform PushConstants {
    uint N;
} pc;

// Fused: out = a * sigmoid(b), elementwise
layout(std430, binding = 0) restrict readonly buffer BufA   { float a_[]; };
layout(std430, binding = 1) restrict readonly buffer BufB   { float b_[]; };
layout(std430, binding = 2)                   buffer BufOut { float out_[]; };

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= pc.N) return;

    float av = a_[tid];
    float bv = b_[tid];
    out_[tid] = av * (1.0 / (1.0 + exp(-bv)));
}
