// FP16 GEMM: C[M,N] = A[M,K] * B[K,N]
//
// Reference (verified) implementation: one thread per output element, dot
// product over K in fp32. Operands A and B are supplied as fp16 in callers that
// exercise the full precision path; this Vulkan variant stores operands/output
// in fp32 for deterministic verification. A folded fp16 (float16_t) variant is a
// follow-up.
//
// Push constants: matches VulkanKernelDispatcher::dispatchFp16Gemm.
#version 460

#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, scalar) uniform PC {
    uint M;
    uint N;
    uint K;
} pc;

// binding 0: A (M * K), row-major
// binding 1: B (K * N), row-major
// binding 2: C (M * N), row-major
layout(std430, binding = 0) restrict readonly  buffer BufA { float a[]; };
layout(std430, binding = 1) restrict readonly  buffer BufB { float b[]; };
layout(std430, binding = 2) restrict writeonly buffer BufO { float o[]; };

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint total = pc.M * pc.N;
    if (tid >= total) {
        return;
    }

    uint r = tid / pc.N; // row in A / output (0..M-1)
    uint c = tid % pc.N; // col in B / output (0..N-1)

    float acc = 0.0;
    for (uint k = 0u; k < pc.K; ++k) {
        acc += a[r * pc.K + k] * b[k * pc.N + c];
    }
    o[tid] = acc;
}
