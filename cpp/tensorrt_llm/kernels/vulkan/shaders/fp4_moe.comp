// FP4 block-scale MoE gate+up projection (decode phase, single token, top-1 routing).
// Vulkan port of the MXFP4 fused MoE weight-only path in
// tensorrt_llm/_torch/modules/fused_moe/quantization.py and
// trtllmGenKernels/blockScaleMoe/runner.cu.
//
// For each output neuron j in [0, intermediateSize):
//   acc = bias[j]
//   for each block of 32 input elements:
//     dequant FP4 weights in block (scale from per-block scaling vector)
//     acc += sum(weight_dequant[i] * input[i])
//   gate_up[j] = acc
//
// FP4 (E2M1) format: 2-bit exponent, 1-bit mantissa.
//   value = (mantissa ? 1.0 : 0.5) * 2^(exponent - 1)
//   Encodings (sign-magnitude, 4 levels): 0→0.0, 1→0.5, 2→1.0, 3→2.0 (unsigned)
//   With per-block float32 scale: dequant = fp4_value * blockScale
//
// Push constants: matches VulkanKernelDispatcher::dispatchFp4Moe.
#version 460

#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// FP4 E2M1 unsigned encoding → float
float decodeFP4(uint code)
{
    // code in [0..3]
    if (code == 0u) return 0.0;
    if (code == 1u) return 0.5;
    if (code == 2u) return 1.0;
    return 2.0;
}

layout(push_constant, scalar) uniform PC {
    uint batchSize;
    uint hiddenSize;        // input dimension (padded)
    uint intermediateSize;  // output dimension (padded)
    uint blockSize;         // threads per block (256)
    uint topK;              // top-k experts (1 for decode)
    uint padSlotId;         // sentinel
} pc;

// Two FP4 values packed into one byte: bits [3:0] = first, [7:4] = second
// binding 0: input          [batchSize * hiddenSize]          (float)
// binding 1: weights        [intermediateSize * (hiddenSize/2)] (uint8_t, packed FP4)
//                                hiddenSize must be even; each byte holds 2 FP4 codes
// binding 2: weightScales   [intermediateSize * (hiddenSize/32)] (float, per-block of 32 inputs)
//                                hiddenSize must be divisible by 32
// binding 3: expertIds       [batchSize * topK]               (uint, expert index per token)
// binding 4: expertOffsets   [numExperts+1]                    (uint, offsets into weights/scales buffers)
// binding 5: bias            [intermediateSize]                 (float, optional)
// binding 6: gateUpOut       [batchSize * intermediateSize]   (float, output)
layout(std430, binding = 0) uniform  BufIn      { float input_[]; };
layout(std430, binding = 1) uniform  BufW       { uint8_t  weights[]; };
layout(std430, binding = 2) uniform  BufWScale  { float    weightScales[]; };
layout(std430, binding = 3) uniform  BufExpert   { uint     expertIds[]; };
layout(std430, binding = 4) uniform  BufExpOff   { uint     expertOffsets[]; };
layout(std430, binding = 5) uniform  BufBias     { float    bias[]; };
layout(std430, binding = 6) buffer   BufOut       { float   out_[]; };

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint b = gl_WorkGroupID.x;
    uint outIdx = gl_WorkGroupID.y * pc.blockSize + tid;

    if (b >= pc.batchSize || outIdx >= pc.intermediateSize)
    {
        return;
    }

    uint expertId = expertIds[b * pc.topK]; // top-1 decode: first expert
    uint expBase = expertOffsets[expertId];
    uint nextExpBase = expertOffsets[expertId + 1u];
    uint weightElemsThisExp = (nextExpBase - expBase) * 2u; // FP4: 2 codes per byte → but actually weight bytes
    uint scaleStrides = (nextExpBase - expBase); // one scale per 32-input block

    uint hiddenPerByte = 2u; // 2 FP4 codes per byte
    uint numBytesForHidden = pc.hiddenSize / hiddenPerByte;
    uint weightRowBytes = numBytesForHidden; // one output neuron's weights
    uint weightRowStart = expBase + outIdx * weightRowBytes;
    uint scaleRowStart = expBase + outIdx * (pc.hiddenSize / 32u);

    float acc = (pc.bias != 0u) ? bias[outIdx] : 0.0;

    // Step by 32 input elements (one block scale).
    uint numBlocks = pc.hiddenSize / 32u;
    for (uint blk = 0u; blk < numBlocks; ++blk)
    {
        float scale = weightScales[scaleRowStart + blk];
        uint byteBase = weightRowStart + blk * 16u; // 32 inputs / 2 per byte = 16 bytes

        // Unroll 32 elements, processing 2 per byte.
        for (uint e = 0u; e < 16u; ++e)
        {
            uint byteIdx = byteBase + e;
            uint8_t packed = weights[byteIdx];
            uint code0 = uint(packed & 0x0Fu);
            uint code1 = uint((packed >> 4u) & 0x0Fu);
            acc += scale * decodeFP4(code0) * input_[b * pc.hiddenSize + blk * 32u + e * 2u];
            acc += scale * decodeFP4(code1) * input_[b * pc.hiddenSize + blk * 32u + e * 2u + 1u];
        }
    }

    out_[b * pc.intermediateSize + outIdx] = acc;
}
