// Chunk-local cumulative sum (forward or reverse).
// Port of chunk_local_cumsum in cumsum.py.
// Operates per chunk of size BT on the T dimension.

#extension GL_EXT_scalar_block_layout : require

#define MAX_BT 64

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, scalar) uniform PC
{
    uint N;
    uint T;
    uint H;
    uint BT;
    bool reverse;
    bool scale;  // multiply by scale factor
    float scaleVal;
}
pc;

// binding 0: input  [N*T*H]
// binding 1: output [N*T*H]
layout(std430, binding = 0) uniform BufIn  { float inArr[]; };
layout(std430, binding = 1) buffer BufOut   { float outArr[]; };

void main()
{
    uint tid = gl_GlobalInvocationID.x;
    uint total = pc.N * pc.T * pc.H;
    if (tid >= total) return;

    uint hIdx = tid % pc.H;
    uint tIdx = (tid / pc.H) % pc.T;
    uint nIdx = tid / (pc.T * pc.H);

    uint chunkIdx = tIdx / pc.BT;
    uint chunkStart = chunkIdx * pc.BT;
    uint chunkEnd = min(chunkStart + pc.BT, pc.T);
    uint offsetInChunk = tIdx - chunkStart;

    float sum;
    if (!pc.reverse)
    {
        // Forward cumsum
        sum = 0.0;
        uint base = nIdx * pc.T * pc.H + chunkStart * pc.H + hIdx;
        for (uint i = 0u; i < offsetInChunk; ++i)
        {
            sum += inArr[base + i * pc.H];
        }
        sum += inArr[base + offsetInChunk * pc.H];
    }
    else
    {
        // Reverse cumsum: sum from end to current position
        sum = 0.0;
        uint base = nIdx * pc.T * pc.H + chunkStart * pc.H + hIdx;
        float total = 0.0;
        for (uint i = 0u; i < (chunkEnd - chunkStart); ++i)
        {
            total += inArr[base + i * pc.H];
        }
        float prefix = 0.0;
        for (uint i = 0u; i < offsetInChunk; ++i)
        {
            prefix += inArr[base + i * pc.H];
        }
        sum = total - prefix + inArr[base + offsetInChunk * pc.H];
    }

    if (pc.scale) sum *= pc.scaleVal;

    uint outIdx = nIdx * pc.T * pc.H + tIdx * pc.H + hIdx;
    outArr[outIdx] = sum;
}
