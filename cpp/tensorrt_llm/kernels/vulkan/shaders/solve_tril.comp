// Solve (I + A)^{-1} for strictly lower-triangular A blocks.
// Port of solve_tril in solve_tril.py.
// One work item per (b, t, h) block — solves BT x BT block.

#extension GL_EXT_scalar_block_layout : require

#define MAX_BT 64

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, scalar) uniform PC
{
    uint B;
    uint T;
    uint H;
    uint BT;
}
pc;

// binding 0: A    [B*T*H*BT*BT]  (strictly lower triangular)
// binding 1: output [B*T*H*BT*BT]
layout(std430, binding = 0) uniform BufA   { float aArr[]; };
layout(std430, binding = 1) buffer BufOut  { float outArr[]; };

void main()
{
    uint tid = gl_GlobalInvocationID.x;
    uint total = pc.B * pc.T * pc.H;
    if (tid >= total) return;

    uint hIdx = tid % pc.H;
    uint tIdx = (tid / pc.H) % pc.T;
    uint bIdx = tid / (pc.T * pc.H);

    uint bt = min(pc.BT, uint(MAX_BT));

    // Load A[t, h] block: [bt, bt], strictly lower triangular
    float A[MAX_BT * MAX_BT];
    uint aBase = bIdx * pc.T * pc.H * bt * bt + tIdx * pc.H * bt * bt + hIdx * bt * bt;
    for (uint i = 0u; i < bt; ++i)
    {
        for (uint j = 0u; j < bt; ++j)
        {
            A[i * bt + j] = aArr[aBase + i * bt + j];
        }
    }

    // Compute (I + A)^{-1} via forward substitution
    // Since A is strictly lower triangular, I+A is lower triangular with 1s on diagonal.
    // Solve (I + A) x = b per row — but we need the full inverse.
    // Inverse of lower triangular = forward substitution.
    // inv[i, j] for i >= j:
    // inv[i, i] = 1/(1 + A[i,i]) = 1 (A is strictly lower, so A[i,i]=0)
    // inv[i, j] = -(sum_{k=j}^{i-1} A[i,k] * inv[k,j]) / (1 + A[i,i])

    float inv[MAX_BT * MAX_BT];
    for (uint i = 0u; i < bt; ++i)
    {
        for (uint j = 0u; j < bt; ++j)
        {
            if (i < j)
            {
                inv[i * bt + j] = 0.0;
            }
            else if (i == j)
            {
                inv[i * bt + j] = 1.0;  // 1 / (1 + 0)
            }
            else
            {
                // inv[i, j] = -(sum_{k=j}^{i-1} A[i,k] * inv[k,j])
                float s = 0.0;
                for (uint k = j; k < i; ++k)
                {
                    s += A[i * bt + k] * inv[k * bt + j];
                }
                inv[i * bt + j] = -s;
            }
        }
    }

    // Write to output
    uint outBase = bIdx * pc.T * pc.H * bt * bt + tIdx * pc.H * bt * bt + hIdx * bt * bt;
    for (uint i = 0u; i < bt; ++i)
    {
        for (uint j = 0u; j < bt; ++j)
        {
            outArr[outBase + i * bt + j] = inv[i * bt + j];
        }
    }
}
