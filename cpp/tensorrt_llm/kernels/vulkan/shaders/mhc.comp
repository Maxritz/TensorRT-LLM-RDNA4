// MHC Combined: single-pass GEMM + post-map for small HC_MULT (e.g. HCHead with N=4).
// This is a correctness-first simplified version combining mhcGemmSqrsumFmaKernel +
// mhcHcHeadApplyKernel into one dispatch. For full Sinkhorn pipeline use mhc_gemm.comp
// + mhc_fuse.comp.
//
// Computes:
//   r_val = sum_k(X[t,k]^2)  (sqrsum)
//   rstd = rsqrt(r_val / K + norm_eps)
//   For each output neuron h:
//     y = sum_k(X[t,k] * W_T[h,k])         (GEMM, fp16 X × fp32 W)
//     g = sigmoid(y * rstd * scale + base) + eps  (gate)
//     layer_in[t, j, h] = g[j] * x[t, j*hidden+h]  (if mult > 1: weighted sum)
//     out[t, h] = sum_j(g[j] * x[t, j*hidden+h])   (or just g[h] if mult=1)
//
// Push constants match VulkanKernelDispatcher::dispatchMhc.
#version 460

#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 256) in;

#define HC_MULT 4
#define BF16_VEC 8
#define BLOCK_SIZE 256
#define WARP_SIZE 32

layout(push_constant, scalar) uniform PC {
    uint M;            // batch tokens
    uint N;            // output neurons (hidden_size)
    uint K;            // input dimension
    uint mult;         // number of input streams (HC_MULT)
    float norm_eps;
    float eps;
    float scale;       // scale[0] for gate sigmoid
    uint padSlotId;
} pc;

// binding 0: X       [M * K]          (fp16)
// binding 1: W_T     [N * K]          (fp32)
// binding 2: sqrsum  [M]              (fp32)
// binding 3: x_mult  [M * mult * N]   (fp16, multiple input streams)
// binding 4: norm_w  [N]              (fp16, gate scale base)
// binding 5: out     [M * N]          (fp16, output)
layout(std430, binding = 0) uniform  BufX     { uint16_t x_[];      };
layout(std430, binding = 1) uniform  BufWT    { float    wT[];     };
layout(std430, binding = 2) uniform  BufSQ    { float    sqr[];     };
layout(std430, binding = 3) uniform  BufXM    { uint16_t xMult[];   };
layout(std430, binding = 4) uniform  BufNW    { uint16_t normW[];   };
layout(std430, binding = 5) buffer  BufOut   { uint16_t out_[];    };

float unpackFp16(uint16_t h)
{
    if (h == 0u) return 0.0;
    uint bits = uint(h);
    uint sign = (bits >> 15u) & 1u;
    uint exp = (bits >> 10u) & 0x1Fu;
    uint mant = bits & 0x3FFu;
    if (exp == 0u)
    {
        if (mant == 0u) return sign == 1u ? -0.0 : 0.0;
        float val = ldexp(float(mant) / 1024.0, -14);
        return sign == 1u ? -val : val;
    }
    if (exp == 31u)
    {
        if (mant == 0u) return sign == 1u ? -1.0/0.0 : 1.0/0.0;
        return 0.0;
    }
    float val = ldexp(float(mant) / 1024.0 + 1.0, int(exp) - 15);
    return sign == 1u ? -val : val;
}

uint16_t packFp16(float f)
{
    if (f == 0.0) return uint16_t(0);
    bool neg = f < 0.0;
    float af = abs(f);
    if (af < ldexp(1.0, -14))
    {
        uint mant = uint(round(af / ldexp(1.0, -24)));
        uint bits = mant & 0x3FFu;
        if (neg) bits |= 0x8000u;
        return uint16_t(bits);
    }
    if (af >= ldexp(65504.0, 0) || isinf(af))
        return uint16_t(neg ? 0xFC00u : 0x7C00u);
    int e = int(floor(log2(af))) + 15;
    float m = af / ldexp(1.0, e - 15);
    uint mant = uint(round((m - 1.0) * 1024.0));
    if (mant >= 1024u) { mant = 0u; e += 1; }
    uint bits = (uint(e) << 10) | (mant & 0x3FFu);
    if (neg) bits |= 0x8000u;
    return uint16_t(bits);
}

shared float s_pre[HC_MULT];

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint token = gl_WorkGroupID.x;
    uint warp_id = tid / WARP_SIZE;
    uint lane = tid % WARP_SIZE;

    if (token >= pc.M)
        return;

    uint xBase = token * pc.K;
    uint outBase = token * pc.N;

    // Phase 1: first `mult` threads compute gate weights
    if (tid < pc.mult)
    {
        float sq = sqr[token];
        float rstd = rsqrt(sq / float(pc.K) + pc.norm_eps);
        // W_T is [N, K] transposed, so W_T[lane] is the lane-th row
        // Actually: y = dot(X[lane], W_T[lane]) — but we need per-stream gates
        // The gate reads: mixes[token * mult + tid] — which is the GEMM output
        // For simplicity, we read from sqrsum buffer which was pre-computed
        // Actually the CUDA code reads: mixes[token * mult + tid] then computes
        // sigmoid(mixes * rstd * scale[0] + base[tid]) + eps
        // We need a mixes buffer... but in the shader we compute it inline

        // Compute gate: sigmoid(dot(X, W_T[tid]) * rstd * scale + base) + eps
        float y_val = 0.0;
        for (uint k = 0u; k < pc.K; k++)
            y_val += unpackFp16(x_[xBase + k]) * wT[tid * pc.K + k];
        float v = y_val * rstd * pc.scale + unpackFp16(normW[tid]);
        s_pre[tid] = 1.0 / (1.0 + exp2(-v)) + pc.eps;
    }
    barrier();

    // Phase 2: weighted sum across mult streams
    for (uint h = tid * uint(BF16_VEC); h < pc.N; h += BLOCK_SIZE * uint(BF16_VEC))
    {
        float acc[BF16_VEC];
        for (uint v = 0u; v < uint(BF16_VEC); v++) acc[v] = 0.0;

        for (uint j = 0u; j < pc.mult; j++)
        {
            float pm = s_pre[j];
            for (uint v = 0u; v < uint(BF16_VEC); v++)
            {
                uint16_t raw = xMult[(token * pc.mult + j) * pc.N + h + v];
                acc[v] += pm * unpackFp16(raw);
            }
        }

        for (uint v = 0u; v < uint(BF16_VEC); v++)
            out_[outBase + h + v] = packFp16(acc[v]);
    }
}
